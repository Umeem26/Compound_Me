  "fixed_sql": [
    {
      "name": "wallets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"wallets\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"name\" TEXT NOT NULL CHECK(LENGTH(\"name\") BETWEEN 1 AND 30), \"type\" TEXT NOT NULL CHECK(\"type\" IN ('cash', 'bank', 'ewallet', 'other')), \"icon_key\" TEXT NOT NULL, \"color_key\" TEXT NOT NULL, \"initial_balance\" INTEGER NOT NULL CHECK(\"initial_balance\" >= 0), \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"archived_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"kind\" TEXT NOT NULL CHECK(\"kind\" IN ('expense', 'income')), \"name_key\" TEXT NULL, \"custom_name\" TEXT NULL CHECK(LENGTH(\"custom_name\") BETWEEN 1 AND 30), \"icon_key\" TEXT NOT NULL, \"color_key\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"archived_at\" TEXT NULL, PRIMARY KEY (\"id\"), CHECK ((name_key IS NULL) <> (custom_name IS NULL)));"
        }
      ]
    },
    {
      "name": "habits",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habits\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"name\" TEXT NOT NULL CHECK(LENGTH(\"name\") BETWEEN 1 AND 40), \"kind\" TEXT NOT NULL CHECK(\"kind\" IN ('build', 'reduce')), \"icon_key\" TEXT NOT NULL, \"color_key\" TEXT NOT NULL, \"schedule_type\" TEXT NOT NULL CHECK(\"schedule_type\" IN ('daily', 'weekdays', 'timesPerWeek')), \"schedule_days\" INTEGER NOT NULL DEFAULT 0 CHECK(\"schedule_days\" BETWEEN 0 AND 127), \"times_per_week\" INTEGER NULL CHECK(\"times_per_week\" BETWEEN 1 AND 7), \"cost_per_occurrence\" INTEGER NULL CHECK(\"cost_per_occurrence\" > 0), \"wallet_id\" TEXT NULL REFERENCES wallets (id) ON DELETE RESTRICT, \"category_id\" TEXT NULL REFERENCES categories (id) ON DELETE RESTRICT, \"weekly_limit\" INTEGER NULL CHECK(\"weekly_limit\" >= 0), \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"archived_at\" TEXT NULL, PRIMARY KEY (\"id\"), CHECK (kind <> 'reduce' OR cost_per_occurrence IS NOT NULL), CHECK (kind <> 'reduce' OR wallet_id IS NOT NULL), CHECK (kind <> 'reduce' OR category_id IS NOT NULL), CHECK (schedule_type <> 'weekdays' OR schedule_days > 0), CHECK (schedule_type <> 'timesPerWeek' OR times_per_week IS NOT NULL));"
        }
      ]
    },
    {
      "name": "habit_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habit_logs\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"habit_id\" TEXT NOT NULL REFERENCES habits (id) ON DELETE CASCADE, \"date\" TEXT NOT NULL, \"count\" INTEGER NOT NULL CHECK(\"count\" >= 1), \"deleted_at\" TEXT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"habit_id\", \"date\"), CHECK (date GLOB '[0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9]'));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"kind\" TEXT NOT NULL CHECK(\"kind\" IN ('expense', 'income')), \"amount\" INTEGER NOT NULL CHECK(\"amount\" > 0), \"wallet_id\" TEXT NOT NULL REFERENCES wallets (id) ON DELETE RESTRICT, \"category_id\" TEXT NOT NULL REFERENCES categories (id) ON DELETE RESTRICT, \"note\" TEXT NULL CHECK(LENGTH(\"note\") <= 120), \"occurred_at\" TEXT NOT NULL, \"habit_log_id\" TEXT NULL REFERENCES habit_logs (id) ON DELETE SET NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
